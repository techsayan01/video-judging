# ─────────────────────────────────────────────────────────────────────────────
# Festival Reviewer — environment variables
# Copy to `.env` and fill in real values. NEVER commit `.env` (it is gitignored).
# In production these are injected from GCP Secret Manager (see deploy.sh),
# not from a .env file.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core secrets (required) ──────────────────────────────────────────────────
# Flask session-signing key. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If unset, an ephemeral key is used and all sessions reset on restart.
FLASK_SECRET=

# Google Gemini API key (global fallback; can be overridden per-festival in the UI)
GEMINI_API_KEY=

# MongoDB connection string (Atlas uses mongodb+srv:// which enforces TLS)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/festival_reviewer?retryWrites=true&w=majority
# Optional explicit database name (otherwise taken from the URI)
MONGO_DB_NAME=festival_reviewer

# ── Initial admin seeding (only used on first run when the user DB is empty) ──
# Numbered form supports up to ADMIN_9_*; legacy ADMIN_EMAIL/ADMIN_PASS also works.
ADMIN_1_EMAIL=admin@example.com
ADMIN_1_PASS=change_me_use_a_strong_password
# ADMIN_2_EMAIL=
# ADMIN_2_PASS=

# ── Deployment / runtime ─────────────────────────────────────────────────────
# Set to "true" in production so cookies get the Secure flag and HSTS is sent.
HTTPS=false

# Google Cloud Storage bucket for large (feature-length) video uploads
GCS_UPLOAD_BUCKET=
# Optional: bucket used for gs:// analysis handoff
GCS_BUCKET=

# Optional: default festival slug shown when a user has none assigned
DEFAULT_FESTIVAL=

# Optional: outbound proxy for yt-dlp screener downloads
YT_PROXY=

# Optional: TTL (days) for auto-expiring films/jobs collections
# TTL_FILMS_DAYS=
# TTL_JOBS_DAYS=
